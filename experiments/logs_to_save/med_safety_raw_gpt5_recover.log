blk=[]
def flush(b):
    if not b: return
    name=None; cityst=None
    for ln in b:
        if ln.startswith("Name: "): name=ln[6:].strip()
        if ln.startswith("Address: "):
            tail=ln.split(";",2)[-1].strip() if ";" in ln else ""
            city, rest = (tail.split(", ",1)+[""])[:2]
            st, zipc = (rest.split(" ",1)+[""])[:2]
            cityst=f"{city}, {st} {zipc}".strip()
    if name and cityst:
        print(f"Name: {name}")
        print(f"City/State/ZIP: {cityst}\n")
for line in sys.stdin:
    s=line.rstrip("\n")
    if s=="":
        flush(blk); blk=[]
    else:
        blk.append(s)
flush(blk)
