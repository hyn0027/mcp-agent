import sys, re
blk=[]
def flush(b):
    if not b: return
    name=None; zipc=None
    for ln in b:
        if ln.startswith("Name: "): name=ln[6:].strip()
        if ln.startswith("Address: "):
            # Expect "... City, ST ZIP"
            tail=ln.split(";",2)[-1].strip() if ";" in ln else ""
            parts = tail.rsplit(" ",1)
            zipc = parts[-1].strip() if parts else ""
        # Normalize ZIP to 5 or ZIP+4 (digits only)
    if name and zipc:
        digits=re.sub(r"\D","",zipc)
        if len(digits)>=9: zipc=f"{digits[:5]}-{digits[5:9]}"
        elif len(digits)>=5: zipc=digits[:5]
        print(f"Name: {name}")
        print(f"ZIP: {zipc}\n")
for line in sys.stdin:
    s=line.rstrip("\n")
    if s=="":
        flush(blk); blk=[]
    else:
        blk.append(s)
flush(blk)
PY
   < outreach_demo_only.txt > outreach_name_zip.txt

