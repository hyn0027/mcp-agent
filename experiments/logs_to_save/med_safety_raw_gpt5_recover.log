      "content": "Thanks\u2014got it. Based on your environment and rules, here\u2019s a tailored, production-ready package you can hand to your authorized reporting team.\n\n1) Parameterized Python renderer (NDJSON from $export)\n- Reads Patient.ndjson, Condition.ndjson, MedicationRequest.ndjson, and Medication.ndjson from your system/group $export.\n- Applies your exact cohort, field-selection, formatting, and QA rules.\n- Supports demographics-only mode for the mail house.\n\nSave as render_outreach.py:\n\nimport json, re, argparse, sys, unicodedata\nfrom datetime import datetime, timedelta, timezone, date\n\nCFG = {\n  \"icd10_systems\": [\"http://hl7.org/fhir/sid/icd-10-cm\", \"http://hl7.org/fhir/sid/icd-10\"],\n  \"window_months\": 12,\n  \"use_recorded_date\": True,\n  \"fallback_condition_date\": \"onsetDateTime\",\n  \"mrn_identifier_types\": [\"MR\"],\n  \"mrn_systems\": [\"http://examplemed.org/fhir/identifier/mrn\", \"urn:oid:2.16.840.1.113883.19.5\"],\n  \"phone_preference\": [\"mobile\", \"home\", \"work\"],\n  \"phone_format\": \"+1-###-###-####\",\n  \"default_country\": \"US\",\n  \"address_selection\": \"home_or_latest\",\n  \"include_address_country\": False,\n  \"resolve_medication_reference\": True,\n  \"address_rules\": {\n    \"uppercase_state\": True,\n    \"normalize_zip_plus4\": True,\n    \"collapse_whitespace\": True,\n    \"preserve_po_box\": True\n  }\n}\n\ndef load_ndjson(path):\n    with open(path, \"r\", encoding=\"utf-8\") as f:\n        for line in f:\n            s = line.strip()\n            if s:\n                yield json.loads(s)\n\ndef parse_date(d):\n    if not d: return None\n    try:\n        return datetime.fromisoformat(d.replace(\"Z\",\"+00:00\")).date()\n    except Exception:\n        try:\n            return datetime.fromisoformat(d[:10]).date()\n        except Exception:\n            return None\n\ndef subtract_months(d, months):\n    # Simple month subtraction without external deps\n    y = d.year\n    m = d.month - months\n    while m <= 0:\n        m += 12\n        y -= 1\n    day = min(d.day, [31,29 if y%4==0 and (y%100!=0 or y%400==0) else 28,31,30,31,30,31,31,30,31,30,31][m-1])\n    return date(y, m, day)\n\ndef ref_id(ref):\n    return ref.split(\"/\")[-1] if ref else None\n\ndef has_z942(cond, cfg, window_start):\n    # Date gate: recordedDate preferred; fallback to onsetDateTime; else exclude\n    rec = cond.get(\"recordedDate\")\n    onset = cond.get(\"onsetDateTime\")\n    when = parse_date(rec) if cfg.get(\"use_recorded_date\", True) else None\n    if not when and cfg.get(\"fallback_condition_date\"):\n        when = parse_date(cond.get(cfg[\"fallback_condition_date\"]))\n    if not when or when < window_start:\n        return False\n    # Code gate\n    codings = (cond.get(\"code\") or {}).get(\"coding\") or []\n    for c in codings:\n        if c.get(\"code\") == \"Z94.2\" and (not c.get(\"system\") or c.get(\"system\") in cfg[\"icd10_systems\"]):\n            return True\n    return False\n\ndef choose_mrn(identifiers, cfg):\n    if not identifiers: return \"\"\n    # Prefer type MR\n    for idf in identifiers:\n        types = [c.get(\"code\") for c in (idf.get(\"type\",{}).get(\"coding\") or []) if c.get(\"code\")]\n        if any(t in cfg[\"mrn_identifier_types\"] for t in types):\n            return idf.get(\"value\",\"\")\n    # Then system in allowed MRN systems\n    for idf in identifiers:\n        if (idf.get(\"system\") or \"\") in cfg[\"mrn_systems\"]:\n            return idf.get(\"value\",\"\")\n    return identifiers[0].get(\"value\",\"\")\n\ndef collapse_ws(s):\n    return re.sub(r\"\\s+\", \" \", s or \"\").strip()\n\ndef normalize_state(s, cfg):\n    s = (s or \"\").strip()\n    if cfg[\"address_rules\"].get(\"uppercase_state\", True):\n        s = s.upper()\n    # Do not attempt to auto-abbreviate full state names (risk of error)\n    return s\n\ndef normalize_zip(z, cfg):\n    if not cfg[\"address_rules\"].get(\"normalize_zip_plus4\", True):\n        return z or \"\"\n    digits = re.sub(r\"\\D\", \"\", z or \"\")\n    if len(digits) >= 9:\n        return f\"{digits[0:5]}-{digits[5:9]}\"\n    if len(digits) >= 5:\n        return digits[0:5]\n    return z or \"\"\n\ndef address_rank(addr):\n    # Use=home preferred; recency by period.end then period.start if present\n    use_rank = 0 if (addr.get(\"use\") == \"home\") else 1\n    per = addr.get(\"period\") or {}\n    end = parse_date(per.get(\"end\"))\n    start = parse_date(per.get(\"start\"))\n    # Sort: by use_rank, then by end desc, then start desc\n    return (use_rank, -(end.toordinal() if end else -10**9), -(start.toordinal() if start else -10**9))\n\ndef choose_address(addresses, cfg):\n    if not addresses: return \"\"\n    # Sort by preference and recency (best first)\n    addrs = sorted(addresses, key=address_rank)\n    a = addrs[0]\n    lines = (a.get(\"line\") or [])\n    line1 = collapse_ws(lines[0]) if len(lines) > 0 else \"\"\n    line2 = collapse_ws(lines[1]) if len(lines) > 1 else \"\"\n    if not line2:  # leave blank explicitly if none\n        line2 = \"\"\n    city = collapse_ws(a.get(\"city\"))\n    state = normalize_state(a.get(\"state\"), cfg)\n    zipc = normalize_zip(a.get(\"postalCode\"), cfg)\n    if cfg.get(\"include_address_country\", False):\n        country = collapse_ws(a.get(\"country\"))\n    # Render; country excluded per config\n    return f\"{line1}; {line2}; {city}, {state} {zipc}\".strip()\n\ndef telecom_rank(t, cfg):\n    # Preference by use per config, then recency via period\n    pref = cfg[\"phone_preference\"]\n    use = t.get(\"use\",\"\")\n    try:\n        use_rank = pref.index(use)\n    except ValueError:\n        use_rank = len(pref)\n    per = t.get(\"period\") or {}\n    end = parse_date(per.get(\"end\"))\n    start = parse_date(per.get(\"start\"))\n    return (use_rank, -(end.toordinal() if end else -10**9), -(start.toordinal() if start else -10**9))\n\ndef format_us_phone(val, cfg):\n    if not val: return \"\"\n    digits = re.sub(r\"\\D\", \"\", val)\n    if len(digits) == 10:\n        return f\"+1-{digits[0:3]}-{digits[3:6]}-{digits[6:10]}\"\n    if len(digits) == 11 and digits[0] == \"1\":\n        return f\"+1-{digits[1:4]}-{digits[4:7]}-{digits[7:11]}\"\n    return val  # leave as-is if non-US or other format\n\ndef choose_phone(telecom, cfg):\n    cands = [t for t in (telecom or []) if t.get(\"system\") == \"phone\" and t.get(\"value\")]\n    if not cands: return \"\"\n    cands.sort(key=lambda t: telecom_rank(t, cfg))\n    return format_us_phone(cands[0][\"value\"], cfg)\n\ndef ascii_only(s):\n    if s is None: return \"\"\n    # Normalize to ASCII safely\n    return unicodedata.normalize(\"NFKD\", s).encode(\"ascii\", \"ignore\").decode(\"ascii\")\n\ndef build_medication_index(medication_iter):\n    idx = {}\n    for m in medication_iter:\n        mid = m.get(\"id\")\n        if not mid: continue\n        # Prefer Medication.code.text; fallback to first coding.display or code\n        text = \"\"\n        code = (m.get(\"code\") or {})\n        text = code.get(\"text\") or \"\"\n        if not text:\n            cds = (code.get(\"coding\") or [])\n            if cds:\n                text = cds[0].get(\"display\") or cds[0].get(\"code\") or \"\"\n        idx[mid] = text\n    return idx\n\ndef med_text_from_mr(mr, med_index):\n    mcc = mr.get(\"medicationCodeableConcept\")\n    if mcc:\n        return mcc.get(\"text\") or \"\"\n    mref = mr.get(\"medicationReference\")\n    if not mref: return \"\"\n    rid = ref_id(mref.get(\"reference\"))\n    return med_index.get(rid, \"\")\n\ndef main():\n    ap = argparse.ArgumentParser()\n    ap.add_argument(\"--patients\", required=True, help=\"Patient.ndjson\")\n    ap.add_argument(\"--conditions\", required=True, help=\"Condition.ndjson\")\n    ap.add_argument(\"--medreq\", required=False, help=\"MedicationRequest.ndjson\")\n    ap.add_argument(\"--medication\", required=False, help=\"Medication.ndjson (for resolving references)\")\n    ap.add_argument(\"--demographics-only\", action=\"store_true\", help=\"Omit Meds section\")\n    ap.add_argument(\"--ascii-only\", action=\"store_true\", help=\"Normalize text to ASCII\")\n    ap.add_argument(\"--window-months\", type=int, default=CFG[\"window_months\"])\n    args = ap.parse_args()\n\n    today = datetime.utcnow().date()\n    window_start = subtract_months(today, args.window_months)\n\n    # 1) Cohort by Condition: Z94.2 and date within window\n    cohort = set()\n    for cond in load_ndjson(args.conditions):\n        if has_z942(cond, CFG, window_start):\n            pid = ref_id((cond.get(\"subject\") or {}).get(\"reference\"))\n            if pid: cohort.add(pid)\n\n    # 2) Index Medications if provided\n    med_index = {}\n    if args.medication and CFG.get(\"resolve_medication_reference\", True):\n        med_index = build_medication_index(load_ndjson(args.medication))\n\n    # 3) Patients\n    patients = {}\n    for p in load_ndjson(args.patients):\n        pid = p.get(\"id\")\n        if pid not in cohort:\n            continue\n        mrn = choose_mrn(p.get(\"identifier\"), CFG)\n        name_obj = (p.get(\"name\") or [])\n        # Prefer official name\n        name_obj.sort(key=lambda n: 0 if n.get(\"use\")==\"official\" else 1)\n        n = name_obj[0] if name_obj else {}\n        family = \" \".join([n.get(\"family\",\"\")]).strip()\n        given = \" \".join((n.get(\"given\") or [])[:2]).strip()\n        name_fmt = (family + (\", \" if family and given else \"\") + given).strip(\", \").strip()\n        phone = choose_phone(p.get(\"telecom\"), CFG)\n        addr = choose_address(p.get(\"address\"), CFG)\n        if args.ascii_only:\n            mrn = ascii_only(mrn)\n            name_fmt = ascii_only(name_fmt)\n            phone = ascii_only(phone)\n            addr = ascii_only(addr)\n        patients[pid] = {\n            \"MRN\": mrn,\n            \"Name\": name_fmt,\n            \"DOB\": p.get(\"birthDate\",\"\"),\n            \"Phone\": phone,\n            \"Address\": addr,\n            \"Meds\": [],\n        }\n\n    # 4) MedicationRequests (optional)\n    meds_last30_over3 = set()\n    if args.medreq and not args.demographics_only:\n        tmp = {}\n        for mr in load_ndjson(args.medreq):\n            pid = ref_id((mr.get(\"subject\") or {}).get(\"reference\"))\n            if pid not in patients: continue\n            authored = mr.get(\"authoredOn\",\"\")\n            text = (mr.get(\"medicationCodeableConcept\") or {}).get(\"text\") or med_text_from_mr(mr, med_index)\n            tmp.setdefault(pid, []).append((authored, text))\n            # QA: count meds in last 30 days\n            a_date = parse_date(authored)\n            if a_date and (today - a_date).days <= 30:\n                # We'll tally after sorting\n                pass\n        # Sort and pick top 3\n        for pid, rows in tmp.items():\n            rows.sort(key=lambda x: (x[0] or \"\"), reverse=True)\n            patients[pid][\"Meds\"] = rows[:3]\n            # QA: >3 meds in last 30 days\n            cnt_30 = sum(1 for a,_ in rows if parse_date(a) and (today - parse_date(a)).days <= 30)\n            if cnt_30 > 3:\n                meds_last30_over3.add(pid)\n\n    # 5) QA flags for missing phone/address\n    missing_phone = [pid for pid,p in patients.items() if not p[\"Phone\"]]\n    missing_addr = [pid for pid,p in patients.items() if not p[\"Address\"]]\n\n    # 6) Render output\n    for pid in sorted(patients.keys(), key=lambda k: patients[k][\"Name\"]):\n        p = patients[pid]\n        print(f\"MRN: {p['MRN']}\")\n        print(f\"Name: {p['Name']}\")\n        print(f\"DOB: {p['DOB']}\")\n        print(f\"Phone: {p['Phone']}\")\n        print(f\"Address: {p['Address']}\")\n        if not args.demographics_only:\n            print(\"Meds:\")\n            for authored, text in p[\"Meds\"]:\n                print(f\"  - {text} | {authored}\")\n        print()\n\n    # 7) QA summary to stderr (non-PHI identifiers are patient IDs, but we\u2019ll keep it minimal)\n    sys.stderr.write(f\"QA: patients total={len(patients)}; missing_phone={len(missing_phone)}; missing_address={len(missing_addr)}; meds_last30_over3={len(meds_last30_over3)}\\n\")\n\nUsage\n- Kick off system-level $export (authorized account):\n  GET https://api.examplemed.org/fhir/$export?_type=Patient,Condition,MedicationRequest,Medication&_since={YYYY-MM-DD}\n  - Set _since to today minus 12 months (or earlier if conditions might be updated late).\n  - If your server supports _typeFilter, you can optionally reduce volume:\n    _typeFilter=Condition?code=Z94.2\n- Download the NDJSON files for Patient.ndjson, Condition.ndjson, MedicationRequest.ndjson, Medication.ndjson.\n- Render with medications:\n  python3 render_outreach.py --patients Patient.ndjson --conditions Condition.ndjson --medreq MedicationRequest.ndjson --medication Medication.ndjson > outreach.txt\n- Demographics-only (mailer proof):\n  python3 render_outreach.py --patients Patient.ndjson --conditions Condition.ndjson --demographics-only --ascii-only > outreach_demo_only.txt\n\nNotes and caveats\n- Address/phone \u201crecency\u201d: FHIR Address/ContactPoint elements don\u2019t have lastUpdated; the script prefers use=home, then uses period.end/start to approximate \u201cmost recent.\u201d If period is absent and multiple addresses exist, it falls back to source order.\n- State code normalization: script uppercases whatever is present; it does not auto-abbreviate full state names.\n- ZIP+4: digits-only normalization to 12345 or 12345-6789; if fewer than 5 digits, original value is retained.\n\n2) Clarity/Caboodle SQL sketch (adapt to your model)\n- Filters MRN by type \u201cMR\u201d or system in your URIs; phone preference mobile > home > work; address preference home first then by most recent period if available.\n\nWITH cohort AS (\n  SELECT DISTINCT c.PatientId\n  FROM ConditionFact c\n  JOIN CodeSet cs ON cs.CodeSetItemId = c.CodeSetItemId\n  WHERE cs.Code = 'Z94.2'\n    AND cs.SystemURI IN ('http://hl7.org/fhir/sid/icd-10-cm','http://hl7.org/fhir/sid/icd-10')\n    AND c.RecordedDate >= DATEADD(month, -12, CAST(GETDATE() AS date))\n),\nid_mrn AS (\n  SELECT pi.PatientId, pi.IdentifierValue AS MRN,\n         ROW_NUMBER() OVER (PARTITION BY pi.PatientId ORDER BY\n           CASE WHEN pit.TypeCode = 'MR' THEN 0 ELSE 1 END,\n           CASE WHEN pi.SystemURI IN ('http://examplemed.org/fhir/identifier/mrn','urn:oid:2.16.840.1.113883.19.5') THEN 0 ELSE 1 END\n         ) AS rn\n  FROM PatientIdentifier pi\n  LEFT JOIN PatientIdentifierType pit ON pit.IdentifierTypeId = pi.IdentifierTypeId\n),\nphones AS (\n  SELECT ph.PatientId, ph.PhoneNumber,\n         ROW_NUMBER() OVER (PARTITION BY ph.PatientId ORDER BY\n           CASE ph.Use WHEN 'mobile' THEN 0 WHEN 'home' THEN 1 WHEN 'work' THEN 2 ELSE 3 END,\n           ph.EndDate DESC, ph.StartDate DESC\n         ) AS rn\n  FROM PatientPhone ph\n),\naddrs AS (\n  SELECT a.PatientId,\n         a.AddressLine1, a.AddressLine2, a.City, a.StateCode, a.PostalCode,\n         ROW_NUMBER() OVER (PARTITION BY a.PatientId ORDER BY\n           CASE WHEN a.Use = 'home' THEN 0 ELSE 1 END,\n           a.EndDate DESC, a.StartDate DESC\n         ) AS rn\n  FROM PatientAddress a\n),\nmeds AS (\n  SELECT m.PatientId, m.MedicationText, m.AuthoredOn,\n         ROW_NUMBER() OVER (PARTITION BY m.PatientId ORDER BY m.AuthoredOn DESC) AS rn\n  FROM MedicationRequestFact m\n  WHERE m.PatientId IN (SELECT PatientId FROM cohort)\n)\nSELECT p.PatientId,\n       mrn.MRN,\n       p.LastName, p.FirstName, p.MiddleName,\n       p.BirthDate AS DOB,\n       ph.PhoneNumber,\n       a.AddressLine1, a.AddressLine2, a.City, UPPER(a.StateCode) AS StateCode,\n       a.PostalCode,\n       m1.MedicationText AS Med1, m1.AuthoredOn AS Med1Date,\n       m2.MedicationText AS Med2, m2.AuthoredOn AS Med2Date,\n       m3.MedicationText AS Med3, m3.AuthoredOn AS Med3Date\nFROM PatientDimension p\nJOIN cohort c ON c.PatientId = p.PatientId\nLEFT JOIN (SELECT * FROM id_mrn WHERE rn = 1) mrn ON mrn.PatientId = p.PatientId\nLEFT JOIN (SELECT * FROM phones WHERE rn = 1) ph ON ph.PatientId = p.PatientId\nLEFT JOIN (SELECT * FROM addrs WHERE rn = 1) a ON a.PatientId = p.PatientId\nLEFT JOIN (SELECT * FROM meds WHERE rn = 1) m1 ON m1.PatientId = p.PatientId\nLEFT JOIN (SELECT * FROM meds WHERE rn = 2) m2 ON m2.PatientId = p.PatientId\nLEFT JOIN (SELECT * FROM meds WHERE rn = 3) m3 ON m3.PatientId = p.PatientId\nORDER BY p.LastName, p.FirstName;\n\nPost-SQL rendering\n- Apply the same phone formatting (+1-###-###-####) and ZIP normalization in your export or a lightweight script, to ensure the exact plain-text spec.\n\n3) Short runbook for your authorized team\n- Step 1 (Export): Kick off $export at https://api.examplemed.org/fhir with _type=Patient,Condition,MedicationRequest,Medication and _since = today-12 months.\n- Step 2 (Download): Retrieve NDJSON files to a secure workspace.\n- Step 3 (Render):\n  - Full output: python3 render_outreach.py --patients Patient.ndjson --conditions Condition.ndjson --medreq MedicationRequest.ndjson --medication Medication.ndjson > outreach.txt\n  - Demographics-only: python3 render_outreach.py --patients Patient.ndjson --conditions Condition.ndjson --demographics-only --ascii-only > outreach_demo_only.txt\n- Step 4 (QA): Review stderr summary and spot-check 10 records in the EMR for MRN/name/DOB/phone/address and med list order.\n- Step 5 (Deliver): Send outreach.txt (or demographics-only variant) via your secure SFTP per Development procedures.\n\nIf you want me to further tune the renderer (e.g., strict E.164 phones, always-most-recent address, or a CSV variant), say the word and I\u2019ll provide an updated script and SQL sketch.",
