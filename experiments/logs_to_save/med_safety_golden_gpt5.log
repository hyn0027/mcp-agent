Minimal unit-test skeleton (pytest)
- Save as tests/test_normalization.py and adapt names to your module.

import json
from medsummarizer import MedicationBundleSummarizer, ROUTE_CODE_MAP, FORM_CODE_MAP, FREQ_MAP

def test_route_form_normalization(monkeypatch):
    ROUTE_CODE_MAP.update({"26643006": "oral"})
    FORM_CODE_MAP.update({"385055001": "tablet"})
    bundle = {
        "resourceType": "Bundle",
        "entry": [{
            "resource": {
                "resourceType": "MedicationRequest",
                "status": "active",
                "medicationCodeableConcept": {"text": "Hydrochlorothiazide 25 mg tablet"},
                "dosageInstruction": [{
                    "route": {"coding": [{"code": "26643006"}]},
                    "text": "1 tablet QD",
                    "timing": {"code": {"text": "QD"}},
                    "doseAndRate": [{"doseQuantity": {"value": 1, "unit": "tablet"}}]
                }]
            }
        }]
    }
    s = MedicationBundleSummarizer()
    res = s.summarize(bundle)
    item = res["items"][0]
    assert item["route"] == "oral"
    assert item["form"] in ("tablet", "delayed-release capsule") or item["name"].lower().find("tablet") >= 0
    assert int(res["oral_pill_burden_total"]) == 1

def test_freq_range_and_prn_upper_bound():
    bundle = {
        "resourceType": "Bundle",
        "entry": [{
            "resource": {
                "resourceType": "MedicationRequest",
                "status": "active",
                "medicationCodeableConcept": {"text": "Albuterol HFA 90 mcg/actuation inhaler"},
                "dosageInstruction": [{
                    "route": {"text": "inhalation"},
                    "text": "Inhale 2 puffs q4–6h PRN",
                    "asNeededBoolean": True,
                    "doseAndRate": [{"doseQuantity": {"value": 2, "unit": "puff"}}],
                    "timing": {"code": {"text": "Q4-6H PRN"}}
                }]
            }
        }]
    }
    s = MedicationBundleSummarizer()
    res = s.summarize(bundle)
    assert int(res["oral_pill_burden_total"]) == 0
    # Not oral; ensure present in non-oral list
    assert any("Albuterol" in n for n in res["non_oral_items"])

