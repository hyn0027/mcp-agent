 med_index)\n        if it:\n            items.append(it)\n\n    # Aggregate (same as summarize)\n    total_daily_oral_pills = round(sum(i[\"daily_pills\"] for i in items), 2)\n    total_oral_prn_upper = round(sum(i[\"oral_prn_upper_bound_daily_pills\"] for i in items), 2)\n    non_oral = [i for i in items if not is_oral_pill(i[\"route\"], i[\"form\"])]\n\n    # Duplicates\n    if suppress_er_ir_duplicates is None:\n        suppress_er_ir_duplicates = self.suppress_er_ir_duplicates\n    dup_flags = {}\n    by_ing_route = defaultdict(list)\n    for it in items:\n        by_ing_route[(lower(it[\"ingredient\"]), lower(it[\"route\"]))].append(it)\n\n    for key, group in by_ing_route.items():\n        if len(group) < 2:\n            continue\n        if suppress_er_ir_duplicates:\n            by_rel = defaultdict(list)\n            for it in group:\n                by_rel[it[\"release_class\"]].append(it)\n            flagged = [sub for sub in by_rel.values() if len(sub) >= 2]\n            if flagged:\n                dup_flags[key] = [[x[\"name\"] for x in sub] for sub in flagged]\n        else:\n            dup_flags[key] = [[x[\"name\"] for x in group]]\n\n    summaries = []\n    for it in items:\n        extra = []\n        if it[\"daily_pills\"] > 0:\n            extra.append(f\"daily pills={int(round(it['daily_pills']))}\")\n        if it[\"prn\"] and it[\"oral_prn_upper_bound_daily_pills\"] > 0:\n            extra.append(f\"PRN upper bound pills={int(round(it['oral_prn_upper_bound_daily_pills']))}\")\n        extra_txt = f\" ; {'; '.join(extra)}\" if extra else \"\"\n        summaries.append(f\"{it['name']} | {it['strength'] or '\u2014'} | {it['form'] or '\u2014'} | {it['route'] or '\u2014'} | {it['freq_label']}{extra_txt}\")\n\n    return {\n        \"items\": items,\n        \"summaries\": summaries,\n        \"oral_pill_burden_total\": total_daily_oral_pills,\n        \"oral_prn_upper_bound_total\": total_oral_prn_upper,\n        \"non_oral_items\": [i[\"name\"] for i in non_oral],\n        \"duplicate_groups\": dup_flags,\n    }\n\n2) CLI: add streaming mode with ijson\n- Reads large Bundles from stdin/file without loading the whole JSON.\n- Best-effort Medication reference resolution; unresolved MedicationRequests are retried after the stream.\n\nPatch (extend medsummarize_cli.py)\n- Requires ijson in your environment (optional).\n\nap.add_argument(\"--stream\", action=\"store_true\", help=\"Stream-parse large Bundle from stdin/file using ijson.\")\nap.add_argument(\"--no-er-ir-suppress\", action=\"store_true\", help=\"Do not suppress IR vs ER duplicates.\")\n\n# After loading/validating input args and optional maps:\nsuppress = not args.no_er_ir_suppress\nsummarizer = MedicationBundleSummarizer(suppress_er_ir_duplicates=suppress)\n\ndef run_stream(path_or_stdin):\n    import ijson\n    # Iterate over entry items: each is {\"resource\": {...}}\n    if path_or_stdin == \"-\":\n        f = sys.stdin\n        close = False\n    else:\n        f = open(path_or_stdin, \"rb\")\n        close = True\n    try:\n        # Stream both Medication and MedicationRequest resources\n        resources = (e.get(\"resource\") for e in ijson.items(f, \"entry.item\"))\n        res = summarizer.summarize_resources(resources_iter=resources)\n        return res\n    finally:\n        if close:\n            f.close()\n\nif args.stream:\n    # Stream directly; no full JSON load\n    res = run_stream(args.inp)\nelse:\n    # Existing non-stream path\n    if args.inp == \"-\":\n        bundle = json.load(sys.stdin)\n    else:\n        p = Path(args.inp)\n        if not p.exists():\n            print(f\"Input not found: {p}\", file=sys.stderr)\n            sys.exit(2)\n        with p.open() as f:\n            bundle = json.load(f)\n    if bundle.get(\"resourceType\") != \"Bundle\":\n        print(\"Input is not a FHIR Bundle resource.\", file=sys.stderr)\n        sys.exit(3)\n    res = summarizer.summarize(bundle)\n\n# Output handling unchanged\ni