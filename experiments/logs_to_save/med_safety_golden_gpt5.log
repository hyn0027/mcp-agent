# --- Run demo and lightweight assertions ----------------------------------

if __name__ == "__main__":
    s = MedicationBundleSummarizer()

    # 1) Baseline synthetic sample
    res = s.summarize(synthetic_sample_bundle())
    print("Per-item summaries:")
    for line in res["summaries"]:
        print(" -", line)
    print("Total daily oral pill count:", int(res["oral_pill_burden_total"]))
    print("Non-oral items:", ", ".join(res["non_oral_items"]))
    print("Duplicates:", res["duplicate_groups"])

    assert int(res["oral_pill_burden_total"]) == 10
    assert set(res["non_oral_items"]) == {
        "Albuterol HFA 90 mcg/actuation inhaler",
        "Insulin glargine 100 unit/mL solution",
        "Timolol 0.5% ophthalmic solution",
    }
    # Duplicate: metformin oral, two products (same release class by default)
    assert any("Metformin 500 mg tablet" in names for names in sum(res["duplicate_groups"].values(), []))

    # 2) Multiple dosageInstruction summed (2 AM + 1 PM = 3/day)
    res2 = s.summarize(fixture_multiple_di_oral())
    assert int(res2["oral_pill_burden_total"]) == 3

    # 3) medicationReference/contained resolution and coding normalization
    res3 = s.summarize(fixture_medication_reference_contained())
    assert res3["items"][0]["form"] == "tablet"
    assert res3["items"][0]["route"] == "oral"
    assert "hydrochlorothiazide" in res3["items"][0]["ingredient"]

    # 4) ER vs IR duplicate suppression: only flag same release class
    res4 = s.summarize(fixture_er_vs_ir_duplicates())
    # Two ER succinate items should flag duplicates; IR vs ER should be suppressed
    # Build a helper to see if any group lists ≥2 names that include 'ER'
    er_grouped = any(
        len([n for n in names if "ER" in n]) >= 2
        for names in sum(res4["duplicate_groups"].values(), [])
    )
    assert er_grouped

    # 5) PRN oral upper bound (excluded from pill burden but computed separately)
    res5 = s.summarize(fixture_prn_oral_upper_bound())
    assert int(res5["oral_pill_burden_total"]) == 0
    # q8h = 3/day; 2 tabs each → upper bound 6
    assert int(res5["oral_prn_upper_bound_total"]) == 6

    print("All synthetic checks passed.")
```

Notes
- Duplicate detection defaults to suppressing IR vs modified-release differences (configurable via suppress_er_ir_duplicates).
- PRN remains excluded from the pill-burden total; an optional oral PRN upper bound is computed for visibility.
- Route/form normalization uses SNOMED examples; extend maps per your local code systems (RxNorm dose form, EDQM, UCUM, etc.).
- Ingredient resolution prefers RxNorm IN when available via Medication.ingredient.
