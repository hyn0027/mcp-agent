- Slightly clearer exit codes and basic schema validation

Drop-in CLI patch (extend your medsummarize_cli.py)

- New CLI flags: --route-map, --form-map, --freq-map, --ingredient-map
- Loads JSON dicts and updates the module’s maps at runtime

Replace your imports with:
from medsummarizer import (
    MedicationBundleSummarizer,
    ROUTE_CODE_MAP, FORM_CODE_MAP, FREQ_MAP,
)

Then extend argparse and load mappings:
ap.add_argument("--route-map", help="JSON file mapping code/display→canonical route (e.g., SNOMED code '26643006': 'oral').")
ap.add_argument("--form-map", help="JSON file mapping code/display→canonical form (e.g., '385055001': 'tablet').")
ap.add_argument("--freq-map", help="JSON file mapping frequency abbreviations to per-day values (e.g., {'qod': 0.5}).")
ap.add_argument("--ingredient-map", help="JSON file mapping brand/synonyms→ingredient (e.g., {'vitamin d3': 'cholecalciferol'}).")

def load_json_map(path):
    import json
    with open(path, "r") as f:
        return json.load(f)

# Before reading input:
if args.route_map:
    ROUTE_CODE_MAP.update(load_json_map(args.route_map))
if args.form_map:
    FORM_CODE_MAP.update(load_json_map(args.form_map))
if args.freq_map:
    FREQ_MAP.update(load_json_map(args.freq_map))
# Optional: provide a hook in your module for ingredient aliasing if you add one there.
# For now, if you expose a KNOWN_INGREDIENTS dict in medsummarizer, you can update it here.
try:
    from medsummarizer import KNOWN_INGREDIENTS
    if args.ingredient_map:
        KNOWN_INGREDIENTS.update(load_json_map(args.ingredient_map))
except ImportError:
    pass

Stdin support and basic validation
- Allow --in - to read from stdin
- Validate resourceType=Bundle and entries present

if args.inp == "-":
    bundle = json.load(sys.stdin)
else:
    p = Path(args.inp)
    if not p.exists():
        print(f"Input not found: {p}", file=sys.stderr)
        sys.exit(2)
    with p.open() as f:
        bundle = json.load(f)

if bundle.get("resourceType") != "Bundle":
    print("Input is not a FHIR Bundle resource.", file=sys.stderr)
    sys.exit(3)

entries = bundle.get("entry") or []
if not entries:
    print("Bundle has no entries; nothing to summarize.", file=sys.stderr)
    sys.exit(0)

