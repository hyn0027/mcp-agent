Let’s proceed via the authorized, de-identified/export workflow. If you share your local route/form code systems (SNOMED, EDQM, RxNorm availability), I can tailor mappings. In the meantime, here’s a minimal CLI wrapper your data team can run on an authorized MedicationRequest Bundle export.

Python CLI wrapper (uses your module’s MedicationBundleSummarizer)

```python
#!/usr/bin/env python3
import json, argparse, sys
from pathlib import Path

# If your summarizer is in medsummarizer.py, import it; else inline it or adjust path.
from medsummarizer import MedicationBundleSummarizer  # adapt import as needed

def main():
    ap = argparse.ArgumentParser(description="Summarize active MedicationRequests (authorized export only).")
    ap.add_argument("--in", dest="inp", required=True, help="Path to FHIR Bundle JSON (MedicationRequest entries).")
    ap.add_argument("--out-json", dest="out_json", help="Optional path to write JSON results.")
    ap.add_argument("--text", dest="text", action="store_true", help="Print human-readable summary to stdout.")
    ap.add_argument("--suppress-er-ir-duplicates", dest="suppress", action="store_true",
                    help="Suppress duplicate flags across IR vs modified-release.")
    args = ap.parse_args()

    p = Path(args.inp)
    if not p.exists():
        print(f"Input not found: {p}", file=sys.stderr)
        sys.exit(1)

    with p.open() as f:
        bundle = json.load(f)

    summarizer = MedicationBundleSummarizer(suppress_er_ir_duplicates=args.suppress)
    res = summarizer.summarize(bundle)

    if args.text:
        print("Per-item summaries:")
        for line in res["summaries"]:
            print(f" - {line}")
        print(f"\nTotal daily oral pill count: {int(round(res['oral_pill_burden_total']))}")
        if res.get("oral_prn_upper_bound_total", 0):
            print(f"Oral PRN upper bound (excluded from total): {int(round(res['oral_prn_upper_bound_total']))}")
        print("Non-oral items:", "; ".join(res["non_oral_items"]) if res["non_oral_items"] else "None")
        if res["duplicate_groups"]:
            print("Potential duplicate therapy flagged for (ingredient, route):")
            for (ing, route), groups in res["duplicate_groups"].items():
                for g in groups:
                    print(f" - {ing} via {route}: " + "; ".join(g))
        else:
            print("No potential duplicate therapies flagged.")

    if args.out_json:
        with open(args.out_json, "w") as f:
            json.dump(res, f, indent=2)
        if not args.text:
            print(f"Wrote summary JSON to {args.out_json}")

if __name__ == "__main__":
    main()
```

Usage
- python medsummarize_cli.py --in authorized_export.json --text --out-json summary.json --suppress-er-ir-duplicates

