      "content": "Glad this helps. Below is a compact Python module that incorporates your robustness enhancements and wraps the logic into a reusable class with a few synthetic tests/fixtures:\n\n- Resolves medicationReference (including contained Medication)\n- Normalizes route/form codings to canonical strings\n- Distinguishes modified-release vs. immediate-release and can suppress duplicate flags across release classes\n- Parses structured Timing (frequency/frequencyMax/period/periodUnit) and common abbreviations (QD, QAM, QPM, QHS, BID, TID, QID, QnH, QOD, weekly, monthly)\n- Sums across multiple dosageInstruction entries\n- Parses doseQuantity, doseRange, and free text (supports split tablets, e.g., 0.5 tab)\n- Excludes PRN from pill burden but also computes an optional \u201coral PRN upper bound\u201d if taken as directed\n\nPython module (illustrative; adapt mappings as needed)\n\n```python\nimport re\nfrom collections import defaultdict, Counter\n\n# --- Canonical maps (extend per local coding sets) -------------------------\n\nROUTE_CODE_MAP = {\n    \"26643006\": \"oral\",          # SNOMED CT\n    \"46713006\": \"inhalation\",\n    \"34206005\": \"subcutaneous\",\n    \"736665006\": \"ophthalmic\",\n}\nFORM_CODE_MAP = {\n    \"385055001\": \"tablet\",       # SNOMED CT\n    \"421606006\": \"capsule\",\n    \"421917000\": \"inhaler\",\n    \"385219001\": \"solution\",\n}\nORAL_ROUTES = {\"oral\", \"po\", \"by mouth\", \"per os\"}\nPILL_FORMS = {\"tablet\", \"tab\", \"capsule\", \"cap\", \"delayed-release capsule\"}\nMR_TOKENS = {\"er\", \"xr\", \"xl\", \"sr\", \"dr\", \"cr\", \"la\", \"extended-release\", \"delayed-release\", \"controlled-release\"}\n\nFREQ_MAP = {\n    \"qd\": 1, \"qam\": 1, \"qpm\": 1, \"qhs\": 1,\n    \"bid\": 2, \"tid\": 3, \"qid\": 4,\n    # optionally add qam/qpm specialized labels (we normalize both to 1/day)\n}\n\n# --- Utilities -------------------------------------------------------------\n\ndef norm(s): return re.sub(r\"\\s+\", \" \", (s or \"\").strip())\ndef lower(s): return norm(s).lower()\n\ndef canon_from_coding_text(coding_arr, text, mapping):\n    # Try coding.code first, then display, then text\n    for c in (coding_arr or []):\n        code = (c.get(\"code\") or \"\").strip()\n        if code and code in mapping:\n            return mapping[code]\n    for c in (coding_arr or []):\n        disp = (c.get(\"display\") or \"\").strip().lower()\n        if disp and disp in mapping.values():\n            return disp\n    t = (text or \"\").strip().lower()\n    return mapping.get(t) or t\n\ndef detect_release_class(form_text, med_text):\n    t = f\"{lower(form_text)} {lower(med_text)}\"\n    if \"delayed-release\" in t or \"dr\" in re.findall(r\"\\b(dr|er|xr|xl|sr|cr|la)\\b\", t):\n        # prefer explicit tokens\n        if re.search(r\"\\bdr\\b|delayed-release\", t): return \"DR\"\n    m = re.findall(r\"\\b(er|xr|xl|sr|cr|la)\\b\", t)\n    if m:\n        return m[0].upper()\n    if \"extended-release\" in t: return \"ER\"\n    return \"IR\"\n\ndef is_oral_pill(route, form):\n    return (lower(route) in ORAL_ROUTES) and (lower(form) in PILL_FORMS)\n\ndef extract_strength(text):\n    m = re.search(r\"(\\d+(\\.\\d+)?\\s*(mg|mcg|g|iu|unit/?mL|units/?mL|%)(/[a-z]+)?)\", text, re.IGNORECASE)\n    return m.group(1) if m else None\n\n# --- Resolution ------------------------------------------------------------\n\ndef build_bundle_index(bundle):\n    idx = {}\n    for e in (bundle.get(\"entry\") or []):\n        r = e.get(\"resource\") or {}\n        if r.get(\"resourceType\") and r.get(\"id\"):\n            idx[(r[\"resourceType\"], r[\"id\"])] = r\n    return idx\n\ndef resolve_medication(mr, bundle_index):\n    # Returns (display_text, ingredient_list (lower strings), form_canonical)\n    cc = mr.get(\"medicationCodeableConcept\")\n    if cc:\n        txt = cc.get(\"text\") or next((c.get(\"display\") for c in cc.get(\"coding\", []) if c.get(\"display\")), \"\")\n        return txt, [], None\n    ref = mr.get(\"medicationReference\") or {}\n    if not ref: return None, [], None\n    ref_id = (ref.get(\"reference\") or \"\").split(\"/\")[-1]\n    med = bundle_index.get((\"Medication\", ref_id))\n    if not med:\n        for contained in (mr.get(\"contained\") or []):\n            if contained.get(\"resourceType\") == \"Medication\" and contained.get(\"id\") == ref_id:\n                med = contained\n                break\n    if not med: return None, [], None\n    text = ((med.get(\"code\") or {}).get(\"text\")) or \"\"\n    # Ingredients (prefer RxNorm IN display if present)\n    ings = []\n    for ing in (med.get(\"ingredient\") or []):\n        item_cc = ing.get(\"itemCodeableConcept\") or {}\n        for c in (item_cc.get(\"coding\") or []):\n            sys = (c.get(\"system\") or \"\").upper()\n            disp = (c.get(\"display\") or \"\").strip()\n            if \"RXNORM\" in sys and disp:\n                ings.append(disp.lower())\n                break\n        if not ings and item_cc.get(\"text\"):\n            ings.append(item_cc[\"text\"].lower())\n    # Form\n    form_cc = med.get(\"form\") or {}\n    form = canon_from_coding_text(form_cc.get(\"coding\"), form_cc.get(\"text\"), FORM_CODE_MAP)\n    return text, ings, form or None\n\ndef extract_med_text(mr):\n    cc = mr.get(\"medicationCodeableConcept\") or {}\n    txt = cc.get(\"text\") or \"\"\n    for c in (cc.get(\"coding\") or []):\n        if not txt and c.get(\"display\"):\n            txt = c[\"display\"]\n    return norm(txt)\n\ndef extract_route(mr):\n    for di in (mr.get(\"dosageInstruction\") or []):\n        r = di.get(\"route\") or {}\n        canon = canon_from_coding_text(r.get(\"coding\"), r.get(\"text\"), ROUTE_CODE_MAP)\n        if canon: return canon\n        t = lower(\" \".join([di.get(\"text\") or \"\", di.get(\"patientInstruction\") or \"\"]))\n        if \"oral\" in t or \"by mouth\" in t or \" po \" in f\" {t} \":\n            return \"oral\"\n        if \"subcut\" in t: return \"subcutaneous\"\n        if \"inhale\" in t or \"inhalation\" in t: return \"inhalation\"\n        if \"ophthalm\" in t: return \"ophthalmic\"\n    return \"\"\n\ndef extract_form_from_text(med_text):\n    t = lower(med_text)\n    if \"delayed-release capsule\" in t: return \"delayed-release capsule\"\n    for f in [\"tablet\", \"tab\", \"capsule\", \"cap\", \"inhaler\", \"solution\", \"ophthalmic solution\", \"patch\", \"suspension\", \"syrup\"]:\n        if f in t:\n            return \"tablet\" if f == \"tab\" else (\"capsule\" if f == \"cap\" else f)\n    return \"\"\n\n# --- Dosing/frequency parsing ---------------------------------------------\n\ndef parse_units_per_dose(di):\n    # Prefer structured dose-and-rate quantities that indicate discrete units (tab/cap/drop/puff)\n    for dr in (di.get(\"doseAndRate\") or []):\n        dq = dr.get(\"doseQuantity\") or {}\n        val = dq.get(\"value\")\n        unit = lower(dq.get(\"unit\") or \"\")\n        if val is not None and re.search(r\"\\b(tab|tablet|cap|capsule|drop|puff|unit|units)\\b\", unit):\n            try: return float(val)\n            except: pass\n        # If unit not informative, still accept numeric value if text clarifies\n    # doseRange: average if units imply discrete oral units\n    for dr in (di.get(\"doseAndRate\") or []):\n        rng = dr.get(\"doseRange\") or {}\n        low, high = (rng.get(\"low\") or {}).get(\"value\"), (rng.get(\"high\") or {}).get(\"value\")\n        unit = lower((rng.get(\"low\") or {}).get(\"unit\") or (rng.get(\"high\") or {}).get(\"unit\") or \"\")\n        if (low or high) and re.search(r\"\\b(tab|tablet|cap|capsule)\\b\", unit):\n            vals = [v for v in [low, high] if v is not None]\n            if vals: return float(sum(vals) / len(vals))\n    # Free text fallback\n    txt = lower(\" \".join([di.get(\"text\") or \"\", di.get(\"patientInstruction\") or \"\"]))\n    m = re.search(r\"\\b(\\d+(\\.\\d+)?)\\s*(tab|tablet|cap|capsule|puff|drop|unit|units)\\b\", txt)\n    if m: return float(m.group(1))\n    # Split tablets like \"0.5 tab\"\n    m = re.search(r\"\\b(0?\\.\\d+)\\s*(tab|tablet|cap|capsule)\\b\", txt)\n    if m: return float(m.group(1))\n    return 1.0\n\ndef parse_freq_per_day(di):\n    tim = di.get(\"timing\") or {}\n    rep = tim.get(\"repeat\") or {}\n    code = tim.get(\"code\") or {}\n\n    # Structured\n    freq = rep.get(\"frequency\")\n    freqMax = rep.get(\"frequencyMax\")\n    per = rep.get(\"period\", 1)\n    unit = rep.get(\"periodUnit\")\n    if (freq or freqMax) and unit:\n        f = float(freqMax or freq or 1)\n        if unit in (\"d\", \"day\", \"days\"): return f / float(per or 1)\n        if unit in (\"h\", \"hour\", \"hours\"): return f * (24.0 / float(per or 1))\n        if unit in (\"wk\", \"w\", \"week\", \"weeks\"): return f / (7.0 * float(per or 1))\n        if unit in (\"mo\", \"month\", \"months\"): return f / (30.0 * float(per or 1))\n\n    # Free text / abbreviations\n    txt = lower(\" \".join([code.get(\"text\") or \"\", di.get(\"text\") or \"\", di.get(\"patientInstruction\") or \"\"]))\n    for k, v in FREQ_MAP.items():\n        if re.search(rf\"\\b{k}\\b\", txt): return float(v)\n    if re.search(r\"\\bqod\\b|\\bevery other day\\b\", txt): return 0.5\n    m = re.search(r\"\\bq(\\d{1,2})h\\b\", txt)     # q6h \u2192 4/day\n    if m:\n        n = int(m.group(1))\n        if n > 0: return 24.0 / n\n    # Ranges like q8\u201312h \u2192 use max for an \"upper bound\" interpretation\n    m = re.search(r\"\\bq(\\d{1,2})\\s*[-\u2013]\\s*(\\d{1,2})h\\b\", txt)\n    if m:\n        lo, hi = int(m.group(1)), int(m.group(2))\n        if hi > 0: return 24.0 / hi\n    if re.search(r\"\\bweekly\\b|\\bqw\\b\", txt): return 1.0 / 7.0\n    if re.search(r\"\\bmonthly\\b|\\bqm\\b\", txt): return 1.0 / 30.0\n    return 1.0\n\ndef is_prn_di(di):\n    if di.get(\"asNeededBoolean\") is True: return True\n    txt = lower(\" \".join([di.get(\"text\") or \"\", di.get(\"patientInstruction\") or \"\"]))\n    return bool(re.search(r\"\\bprn\\b\", txt))\n\ndef freq_label_from_val(val):\n    for k, v in FREQ_MAP.items():\n        if abs(val - v) < 1e-6:\n            return k.upper()\n    return f\"{val:.2f}x/day\" if abs(val - round(val)) > 1e-6 else f\"{int(round(val))}x/day\"\n\n# --- Core summarizer -------------------------------------------------------\n\nclass MedicationBundleSummarizer:\n    def __init__(self, suppress_er_ir_duplicates=True):\n        self.suppress_er_ir_duplicates = suppress_er_ir_duplicates\n\n    def summarize(self, bundle):\n        idx = build_bundle_index(bundle)\n        items = []\n\n        for e in (bundle.get(\"entry\") or []):\n            mr = e.get(\"resource\") or {}\n            if mr.get(\"resourceType\") != \"MedicationRequest\": continue\n            status = lower(mr.get(\"status\") or \"active\")\n            if status != \"active\": continue\n\n            med_text, med_ings, med_form = resolve_medication(mr, idx)\n            if not med_text: med_text = extract_med_text(mr)\n            route = extract_route(mr)\n            form = med_form or extract_form_from_text(med_text)\n            strength = extract_strength(med_text) or \"\"\n\n            # Aggregate across multiple dosageInstruction entries\n            per_di_freq_labels = []\n            daily_pills = 0.0\n            prn_upper_oral = 0.0\n            any_prn = False\n            for di in (mr.get(\"dosageInstruction\") or []):\n                di_prn = is_prn_di(di)\n                any_prn = any_prn or di_prn\n                units = parse_units_per_dose(di)\n                freq = parse_freq_per_day(di)\n                per_di_freq_labels.append(freq_label_from_val(freq) + (\" PRN\" if di_prn else \"\"))\n\n                if is_oral_pill(route, form):\n                    if not di_prn:\n                        daily_pills += units * freq\n                    else:\n                        # Optional PRN upper bound for oral pills\n                        prn_upper_oral += units * freq\n\n            # Ingredient canonical (prefer Medication.ingredient if present)\n            ingredient = (med_ings[0] if med_ings else lower(med_text).split(\",\")[0].split()[0])\n\n            items.append({\n                \"name\": med_text,\n                \"ingredient\": ingredient,\n                \"form\": form or \"\",\n                \"route\": route or \"\",\n                \"release_class\": detect_release_class(form or \"\", med_text),\n                \"strength\": strength,\n                \"prn\": any_prn,\n                \"daily_pills\": daily_pills,\n                \"oral_prn_upper_bound_daily_pills\": prn_upper_oral,\n                \"freq_label\": \" + \".join(per_di_freq_labels) if per_di_freq_labels else \"\",\n            })\n\n        # Totals and non-oral\n        total_daily_oral_pills = round(sum(i[\"daily_pills\"] for i in items), 2)\n        total_oral_prn_upper_bound = round(sum(i[\"oral_prn_upper_bound_daily_pills\"] for i in items), 2)\n        non_oral = [i for i in items if not is_oral_pill(i[\"route\"], i[\"form\"])]\n\n        # Duplicate detection: by ingredient + route, with optional release-class suppression\n        dup_flags = {}\n        by_ing_route = defaultdict(list)\n        for it in items:\n            by_ing_route[(lower(it[\"ingredient\"]), lower(it[\"route\"]))].append(it)\n\n        for key, group in by_ing_route.items():\n            if len(group) < 2: continue\n            if self.suppress_er_ir_duplicates:\n                by_rel = defaultdict(list)\n                for it in group:\n                    by_rel[it[\"release_class\"]].append(it)\n                # Flag only subgroups with >=2 within the same release class\n                flagged = [sub for sub in by_rel.values() if len(sub) >= 2]\n                if flagged:\n                    dup_flags[key] = [[x[\"name\"] for x in sub] for sub in flagged]\n            else:\n                dup_flags[key] = [[x[\"name\"] for x in group]]\n\n        # Concise per-item summaries\n        summaries = []\n        for it in items:\n            extra = []\n            if it[\"daily_pills\"] > 0:\n                extra.append(f\"daily pills={int(round(it['daily_pills']))}\")\n            if it[\"prn\"] and it[\"oral_prn_upper_bound_daily_pills\"] > 0:\n                extra.append(f\"PRN upper bound pills={int(round(it['oral_prn_upper_bound_daily_pills']))}\")\n            extra_txt = f\" ; {'; '.join(extra)}\" if extra else \"\"\n            summaries.append(f\"{it['name']} | {it['strength'] or '\u2014'} | {it['form'] or '\u2014'} | {it['route'] or '\u2014'} | {it['freq_label']}{extra_txt}\")\n\n        return {\n            \"items\": items,\n            \"summaries\": summaries,\n            \"oral_pill_burden_total\": total_daily_oral_pills,\n            \"oral_prn_upper_bound_total\": total_oral_prn_upper_bound,\n            \"non_oral_items\": [i[\"name\"] for i in non_oral],\n            \"duplicate_groups\": dup_flags,  # keys: (ingredient, route), values: list of duplicate sublists\n        }\n\n# --- Synthetic fixtures and quick tests -----------------------------------\n\ndef synthetic_sample_bundle():\n    return {\n        \"resourceType\": \"Bundle\",\n        \"entry\": [\n            {\"resource\": {\"resourceType\": \"MedicationRequest\", \"status\": \"active\",\n                \"medicationCodeableConcept\": {\"text\": \"Metformin 500 mg tablet\"},\n                \"dosageInstruction\": [{\"route\": {\"text\": \"oral\"},\n                                       \"text\": \"1 tablet BID\",\n                                       \"doseAndRate\": [{\"doseQuantity\": {\"value\": 1, \"unit\": \"tablet\"}}],\n                                       \"timing\": {\"code\": {\"text\": \"BID\"}}}]}},\n            {\"resource\": {\"resourceType\": \"MedicationRequest\", \"status\": \"active\",\n                \"medicationCodeableConcept\": {\"text\": 