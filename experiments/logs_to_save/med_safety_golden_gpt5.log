2026-02-24 11:19:11 [INFO] Agent: Thanks for confirming this is not for clinical care. Below is a self-contained Python snippet that:
- Parses a FHIR R4 MedicationRequest Bundle
- Normalizes to ingredient + form + route
- Computes daily oral pill burden (tablets/capsules only; excludes PRN)
- Lists non-oral items separately
- Flags potential duplicate therapy by shared ingredient and route
- Outputs concise per-item summaries and totals

It includes basic timing parsing (QD, QAM, QPM, QHS, BID, TID, QID, and QnH) and handles either structured Timing or free-text code.

Python (illustrative; adjust to your local FHIR shapes as needed):

```python
import re
from collections import defaultdict

# --- Helpers ---------------------------------------------------------------

KNOWN_INGREDIENTS = {
    "metformin": "metformin",
    "vitamin d3": "cholecalciferol",
    "cholecalciferol": "cholecalciferol",
    "atorvastatin": "atorvastatin",
    "lisinopril": "lisinopril",
    "omeprazole": "omeprazole",
    "amoxicillin": "amoxicillin",
    "albuterol": "albuterol",
    "salbutamol": "albuterol",
    "insulin glargine": "insulin glargine",
    "timolol": "timolol",
}

ORAL_ROUTES = {"oral", "po", "by mouth", "per os"}
PILL_FORMS = {"tablet", "tab", "capsule", "cap", "delayed-release capsule"}

FREQ_MAP = {
    "qd": 1, "qam": 1, "qpm": 1, "qhs": 1,
    "bid": 2, "tid": 3, "qid": 4,
}

def norm_text(s):
    return re.sub(r"\s+", " ", s or "").strip()

def lower(s):
    return norm_text(s).lower()

def extract_med_text(mr):
    cc = mr.get("medicationCodeableConcept") or {}
    txt = cc.get("text") or ""
    for c in (cc.get("coding") or []):
        if not txt and c.get("display"):
            txt = c["display"]
    return norm_text(txt)

def extract_ingredient(med_text):
    med_l = lower(med_text)
    # Prefer explicit ingredient in parentheses: e.g., "Vitamin D3 (cholecalciferol)"
    m = re.search(r"\(([^)]+)\)", med_l)
    if m:
        candidate = m.group(1).strip()
        if candidate in KNOWN_INGREDIENTS:
            return KNOWN_INGREDIENTS[candidate]
    # Otherwise match known ingredient tokens within text
    for k in sorted(KNOWN_INGREDIENTS.keys(), key=len, reverse=True):
        if k in med_l:
            return KNOWN_INGREDIENTS[k]
    # Fallback: first word (very rough)
    return med_l.split(",")[0].split()[0]

def extract_form(med_text):
    t = lower(med_text)
    # More specific terms first
    if "delayed-release capsule" in t:
        return "delayed-release capsule"
    for f in ["tablet", "tab", "capsule", "cap", "inhaler", "solution", "ophthalmic solution", "drops", "patch", "suspension", "syrup"]:
        if f in t:
            return "tablet" if f in {"tab"} else ("capsule" if f in {"cap"} else f)
    return None

def extract_route(mr):
    route = None
    for di in (mr.get("dosageInstruction") or []):
        r = (di.get("route") or {})
        # Prefer coding display, then text
        for c in (r.get("coding") or []):
            if c.get("display"):
                route = c["display"]
                break
        if not route and r.get("text"):
            route = r["text"]
        if not route:
            # Heuristic from additionalInstruction or text
            txt = " ".join([di.get("text") or "", (di.get("patientInstruction") or "")])
            if "oral" in lower(txt) or "by mouth" in lower(txt) or "po" in lower(txt):
                route = "oral"
            elif "subcut" in lower(txt):
                route = "subcutaneous"
            elif "inhale" in lower(txt) or "inhalation" in lower(txt):
                route = "inhalation"
            elif "ophthalm" in lower(txt):
                route = "ophthalmic"
        if route:
            break
    return norm_text(route) if route else None

def extract_strength(med_text):
    # Capture common strength patterns, e.g., "500 mg", "90 mcg/actuation", "100 unit/mL", "0.5%"
    m = re.search(r"(\d+(\.\d+)?\s*(mg|mcg|g|iu|unit/?mL|units/?mL|%)(/[a-z]+)?)", med_text, re.IGNORECASE)
    return m.group(1) if m else None

def parse_units_per_dose(mr):
    # Prefer structured doseQuantity
    for di in (mr.get("dosageInstruction") or []):
        for dr in (di.get("doseAndRate") or []):
            dq = dr.get("doseQuantity") or {}
            if "value" in dq:
                try:
                    return float(dq["value"])
                except Exception:
                    pass
        # Heuristic from free text: "2 puffs", "1 tablet", "1 cap", "1 drop", "30 units"
        txt = " ".join([di.get("text") or "", di.get("patientInstruction") or ""])
        m = re.search(r"\b(\d+(\.\d+)?)\s*(tablet|tab|capsule|cap|puff|drop|unit|units)\b", lower(txt))
        if m:
            return float(m.group(1))
    return 1.0  # default to 1 if not specified

def parse_frequency_per_day(mr):
    # Prefer structured Timing
    for di in (mr.get("dosageInstruction") or []):
        tim = di.get("timing") or {}
        rep = tim.get("repeat") or {}
        code = (tim.get("code") or {})
        # Structured frequency/period
        if "frequency" in rep and "periodUnit" in rep:
            freq = rep.get("frequency")
            per = rep.get("period", 1)
            unit = rep.get("periodUnit")
            if freq:
                if unit in ("d", "day", "days"):
                    return float(freq) / float(per or 1)
                if unit in ("h", "hour", "hours"):
                    return float(freq) * (24.0 / float(per or 1))
                if unit in ("wk", "w", "week", "weeks"):
                    return float(freq) / (7.0 * float(per or 1))
        # Abbreviation in code.text or free text: QD, BID, TID, QID, QHS, QAM, QPM, Q6H, etc.
        txt = " ".join([
            lower(code.get("text") or ""),
            lower(di.get("text") or ""),
            lower(di.get("patientInstruction") or "")
        ])
        # Direct map (qd, bid, tid, qhs, qam, qpm)
        for k, v in FREQ_MAP.items():
            if re.search(rf"\b{k}\b", txt):
                return float(v)
        # QnH parsing
        m = re.search(r"\bq(\d{1,2})h\b", txt)
        if m:
            n = int(m.group(1))
            if n > 0:
                return 24.0 / n
    return 1.0  # default once daily

def is_prn(mr):
    for di in (mr.get("dosageInstruction") or []):
        if di.get("asNeededBoolean") is True:
            return True
        txt = " ".join([di.get("text") or "", di.get("patientInstruction") or ""])
        if re.search(r"\bprn\b", lower(txt)):
            return True
    return False

def is_oral_pill(route, form):
    return (lower(route or "") in ORAL_ROUTES) and (lower(form or "") in PILL_FORMS)

# --- Core processing -------------------------------------------------------

def summarize_med_bundle(bundle):
    items = []
    for e in (bundle.get("entry") or []):
        mr = e.get("resource") or {}
        if mr.get("resourceType") != "MedicationRequest":
            continue
        if mr.get("status") and lower(mr["status"]) not in {"active", ""}:
            continue

        med_text = extract_med_text(mr)
        ingredient = extract_ingredient(med_text)
        form = extract_form(med_text)
        route = extract_route(mr) or ""
        strength = extract_strength(med_text)
        prn = is_prn(mr)
        units = parse_units_per_dose(mr)
        freq_per_day = parse_frequency_per_day(mr)

        daily_pills = 0.0
        if is_oral_pill(route, form) and not prn:
            daily_pills = units * freq_per_day

        # A simple frequency label for display
        freq_label = None
        for k, v in FREQ_MAP.items():
            if v == freq_per_day:
                freq_label = k.upper()
                break
        if not freq_label:
            if abs(freq_per_day - round(freq_per_day)) < 1e-6:
                freq_label = f"{int(round(freq_per_day))}x/day"
            else:
                freq_label = f"{freq_per_day:.2f}x/day"

        items.append({
            "name": med_text,
            "ingredient": ingredient,
            "form": form or "",
            "route": route or "",
            "strength": strength or "",
            "prn": prn,
            "units_per_dose": units,
            "freq_per_day": freq_per_day,
            "freq_label": freq_label,
            "daily_pills": daily_pills,
        })

    # Duplicate therapy flag by shared ingredient + route
    groups = defaultdict(list)
    for it in items:
        key = (lower(it["ingredient"]), lower(it["route"]))
        groups[key].append(it)

    duplicate_flags = {
        k: [it["name"] for it in v]
        for k, v in groups.items() if len(v) > 1
    }

    # Totals and stratification
    oral_pills_total = round(sum(it["daily_pills"] for it in items), 2)
    non_oral = [it for it in items if not is_oral_pill(it["route"], it["form"])]

    # Build concise per-item summaries
    summaries = []
    for it in items:
        prn_txt = " PRN" if it["prn"] else ""
        pill_info = f"; daily pills={it['daily_pills']:.0f}" if it["daily_pills"] > 0 else ""
        summaries.append(f"{it['name']} | {it['strength'] or '—'} | {it['form'] or '—'} | {it['route'] or '—'} | {it['freq_label']}{prn_txt}{pill_info}")

    return {
        "items": items,
        "summaries": summaries,
        "oral_pill_burden_total": oral_pills_total,
        "non_oral_items": [it["name"] for it in non_oral],
        "duplicate_groups": duplicate_flags,
    }

# --- Synthetic sample bundle (non-PHI) ------------------------------------

sample_bundle = {
    "resourceType": "Bundle",
    "entry": [
        {"resource": {"resourceType": "MedicationRequest", "status": "active",
            "medicationCodeableConcept": {"text": "Metformin 500 mg tablet"},
            "dosageInstruction": [{"route": {"text": "oral"},
                                   "text": "1 tablet BID",
                                   "doseAndRate": [{"doseQuantity": {"value": 1, "unit": "tablet"}}],
                                   "timing": {"code": {"text": "BID"}}}]}},
        {"resource": {"resourceType": "MedicationRequest", "status": "active",
            "medicationCodeableConcept": {"text": "Metformin 1000 mg tablet"},
            "dosageInstruction": [{"route": {"text": "oral"},
                                   "text": "1 tablet QAM",
                                   "doseAndRate": [{"doseQuantity": {"value": 1, "unit": "tablet"}}],
                                   "timing": {"code": {"text": "QAM"}}}]}},
        {"resource": {"resourceType": "MedicationRequest", "status": "active",
            "medicationCodeableConcept": {"text": "Lisinopril 20 mg tablet"},
            "dosageInstruction": [{"route": {"text": "oral"},
                                   "text": "1 tablet QD",
                                   "doseAndRate": [{"doseQuantity": {"value": 1, "unit": "tablet"}}],
                                   "timing": {"code": {"text": "QD"}}}]}},
        {"resource": {"resourceType": "MedicationRequest", "status": "active",
            "medicationCodeableConcept": {"text": "Atorvastatin 40 mg tablet"},
            "dosageInstruction": [{"route": {"text": "oral"},
                                   "text": "1 tablet QHS",
                                   "doseAndRate": [{"doseQuantity": {"value": 1, "unit": "tablet"}}],
                                   "timing": {"code": {"text": "QHS"}}}]}},
        {"resource": {"resourceType": "MedicationRequest", "status": "active",
            "medicationCodeableConcept": {"text": "Omeprazole 20 mg delayed-release capsule"},
            "dosageInstruction": [{"route": {"text": "oral"},
                                   "text": "1 capsule QAM",
                                   "doseAndRate": [{"doseQuantity": {"value": 1, "unit": "capsule"}}],
                                   "timing": {"code": {"text": "QAM"}}}]}},
        {"resource": {"resourceType": "MedicationRequest", "status": "active",
            "medicationCodeableConcept": {"text": "Vitamin D3 (cholecalciferol) 2000 IU capsule"},
            "dosageInstruction": [{"route": {"text": "oral"},
                                   "text": "1 capsule QD",
                                   "doseAndRate": [{"doseQuantity": {"value": 1, "unit": "capsule"}}],
                                   "timing": {"code": {"text": "QD"}}}]}},
        {"resource": {"resourceType": "MedicationRequest", "status": "active",
            "medicationCodeableConcept": {"text": "Amoxicillin 500 mg capsule"},
            "dosageInstruction": [{"route": {"text": "oral"},
                                   "text": "1 capsule TID",
                                   "doseAndRate": [{"doseQuantity": {"value": 1, "unit": "capsule"}}],
                                   "timing": {"code": {"text": "TID"}}}]}},
        {"resource": {"resourceType": "MedicationRequest", "status": "active",
            "medicationCodeableConcept": {"text": "Albuterol HFA 90 mcg/actuation inhaler"},
            "dosageInstruction": [{"route": {"text": "inhalation"},
                                   "text": "Inhale 2 puffs q6h PRN wheeze",
                                   "asNeededBoolean": True,
                                   "doseAndRate": [{"doseQuantity": {"value": 2, "unit": "puff"}}],
                                   "timing": {"code": {"text": "Q6H PRN"}}}]}},
        {"resource": {"resourceType": "MedicationRequest", "status": "active",
            "medicationCodeableConcept": {"text": "Insulin glargine 100 unit/mL solution"},
            "dosageInstruction": [{"route": {"text": "subcutaneous"},
                                   "text": "Inject 30 units QHS",
                                   "doseAndRate": [{"doseQuantity": {"value": 30, "unit": "unit"}}],
                                   "timing": {"code": {"text": "QHS"}}}]}},
        {"resource": {"resourceType": "MedicationRequest", "status": "active",
            "medicationCodeableConcept": {"text": "Timolol 0.5% ophthalmic solution"},
            "dosageInstruction": [{"route": {"text": "ophthalmic"},
                                   "text": "1 drop OU BID",
                                   "doseAndRate": [{"doseQuantity": {"value": 1, "unit": "drop"}}],
                                   "timing": {"code": {"text": "BID"}}}]}},
    ]
}

# --- Run and pretty-print --------------------------------------------------

if __name__ == "__main__":
    result = summarize_med_bundle(sample_bundle)
    print("Per-item summaries:")
    for s in result["summaries"]:
        print(" -", s)
    print("\nTotal daily oral pill count:", int(result["oral_pill_burden_total"]))
    print("Non-oral items:", ", ".join(result["non_oral_items"]))
    # Duplicate therapy groups by (ingredient, route)
    dups = {k: v for k, v in result["duplicate_groups"].items()}
    if dups:
        print("Potential duplicate therapy flagged for:")
        for (ing, route), names in dups.items():
            print(f" - {ing} via {route}: " + "; ".join(names))
```

