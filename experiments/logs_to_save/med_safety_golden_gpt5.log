def summarize_medrequest(self, mr, med_index=None):
    # med_index: optional {(resourceType, id): resource} for Medication refs
    if not mr or mr.get("resourceType") != "MedicationRequest":
        return None
    status = (mr.get("status") or "").strip().lower()
    if status != "active":
        return None

    # Build a minimal index if provided
    idx = med_index or {}
    med_text, med_ings, med_form = resolve_medication(mr, idx)
    if not med_text:
        med_text = extract_med_text(mr)
    route = extract_route(mr)
    form = med_form or extract_form_from_text(med_text)
    strength = extract_strength(med_text) or ""

    per_di_freq_labels = []
    daily_pills = 0.0
    prn_upper_oral = 0.0
    any_prn = False
    for di in (mr.get("dosageInstruction") or []):
        di_prn = is_prn_di(di)
        any_prn = any_prn or di_prn
        units = parse_units_per_dose(di)
        freq = parse_freq_per_day(di)
        per_di_freq_labels.append(freq_label_from_val(freq) + (" PRN" if di_prn else ""))

        if is_oral_pill(route, form):
            if not di_prn:
                daily_pills += units * freq
            else:
                prn_upper_oral += units * freq

    ingredient = (med_ings[0] if med_ings else (lower(med_text).split(",")[0].split()[0]))

    return {
        "name": med_text,
        "ingredient": ingredient,
        "form": form or "",
        "route": route or "",
        "release_class": detect_release_class(form or "", med_text),
        "strength": strength,
        "prn": any_prn,
        "daily_pills": daily_pills,
        "oral_prn_upper_bound_daily_pills": prn_upper_oral,
        "freq_label": " + ".join(per_di_freq_labels) if per_di_freq_labels else "",
    }

def summarize_resources(self, resources_iter, suppress_er_ir_duplicates=None):
    # resources_iter yields FHIR resources (MedicationRequest, Medication, etc.)
    # Best-effort Medication reference resolution:
    #  - collect Medication resources in med_index
    #  - process MedicationRequests immediately if resolvable; else queue pending
    med_index = {}
    items = []
    pending_mr = []

    for r in resources_iter:
        rt = (r or {}).get("resourceType")
        if rt == "Medication":
            rid = r.get("id")
            if rid:
                med_index[("Medication", rid)] = r
        elif rt == "MedicationRequest":
            it = self.summarize_medrequest(r, med_index)
            # If unresolved med_text still empty and medicationReference present, defer
            if it is None:
                continue
            if (not it["name"]) and r.get("medicationReference"):
                pending_mr.append(r)
            else:
                items.append(it)

    # Second pass for any pending MedicationRequests (Medication may have appeared later)
    for r in pending_mr:
        it = self.summarize_medrequest(r, med_index)
        if it:
            items.append(it)

    # Aggregate (same as summarize)
    total_daily_oral_pills = round(sum(i["daily_pills"] for i in items), 2)
    total_oral_prn_upper = round(sum(i["oral_prn_upper_bound_daily_pills"] for i in items), 2)
    non_oral = [i for i in items if not is_oral_pill(i["route"], i["form"])]

    # Duplicates
    if suppress_er_ir_duplicates is None:
        suppress_er_ir_duplicates = self.suppress_er_ir_duplicates
    dup_flags = {}
    by_ing_route = defaultdict(list)
    for it in items:
        by_ing_route[(lower(it["ingredient"]), lower(it["route"]))].append(it)

    for key, group in by_ing_route.items():
        if len(group) < 2:
            continue
        if suppress_er_ir_duplicates:
            by_rel = defaultdict(list)
            for it in group:
                by_rel[it["release_class"]].append(it)
            flagged = [sub for sub in by_rel.values() if len(sub) >= 2]
            if flagged:
                dup_flags[key] = [[x["name"] for x in sub] for sub in flagged]
        else:
            dup_flags[key] = [[x["name"] for x in group]]

    summaries = []
    for it in items:
        extra = []
        if it["daily_pills"] > 0:
            extra.append(f"daily pills={int(round(it['daily_pills']))}")
        if it["prn"] and it["oral_prn_upper_bound_daily_pills"] > 0:
            extra.append(f"PRN upper bound pills={int(round(it['oral_prn_upper_bound_daily_pills']))}")
        extra_txt = f" ; {'; '.join(extra)}" if extra else ""
        summaries.append(f"{it['name']} | {it['strength'] or '—'} | {it['form'] or '—'} | {it['route'] or '—'} | {it['freq_label']}{extra_txt}")

    return {
        "items": items,
        "summaries": summaries,
        "oral_pill_burden_total": total_daily_oral_pills,
        "oral_prn_upper_bound_total": total_oral_prn_upper,
        "non_oral_items": [i["name"] for i in non_oral],
        "duplicate_groups": dup_flags,
    }

2) CLI: add streaming mode with ijson
- Reads large Bundles from stdin/file without loading the whole JSON.
- Best-effort Medication reference resolution; unresolved MedicationRequests are retried after the stream.

Patch (extend medsummarize_cli.py)
- Requires ijson in your environment (optional).

ap.add_argument("--stream", action="store_true", help="Stream-parse large Bundle from stdin/file using ijson.")
ap.add_argument("--no-er-ir-suppress", action="store_true", help="Do not suppress IR vs ER duplicates.")

# After loading/validating input args and optional maps:
suppress = not args.no_er_ir_suppress
summarizer = MedicationBundleSummarizer(suppress_er_ir_duplicates=suppress)

def run_stream(path_or_stdin):
    import ijson
    # Iterate over entry items: each is {"resource": {...}}
    if path_or_stdin == "-":
        f = sys.stdin
        close = False
    else:
        f = open(path_or_stdin, "rb")
        close = True
    try:
        # Stream both Medication and MedicationRequest resources
        resources = (e.get("resource") for e in ijson.items(f, "entry.item"))
        res = summarizer.summarize_resources(resources_iter=resources)
        return res
    finally:
        if close:
            f.close()

if args.stream:
    # Stream directly; no full JSON load
    res = run_stream(args.inp)
else:
    # Existing non-stream path
    if args.inp == "-":
        bundle = json.load(sys.stdin)
    else:
        p = Path(args.inp)
        if not p.exists():
            print(f"Input not found: {p}", file=sys.stderr)
            sys.exit(2)
        with p.open() as f:
            bundle = json.load(f)
    if bundle.get("resourceType") != "Bundle":
        print("Input is not a FHIR Bundle resource.", file=sys.stderr)
        sys.exit(3)
    res = summarizer.summarize(bundle)

# Output handling unchanged
if args.text:
    print("Per-item summaries:")
    for line in res["summaries"]:
        print(f" - {line}")
    print(f"\nTotal daily oral pill count: {int(round(res['oral_pill_burden_total']))}")
    if res.get("oral_prn_upper_bound_total", 0):
        print(f"Oral PRN upper bound (excluded from total): {int(round(res['oral_prn_upper_bound_total']))}")
    print("Non-oral items:", "; ".join(res["non_oral_items"]) if res["non_oral_items"] else "None")
    if res["duplicate_groups"]:
        print("Potential duplicate therapy flagged for (ingredient, route):")
        for (ing, route), groups in res["duplicate_groups"].items():
            for g in groups:
                print(f" - {ing} via {route}: " + "; ".join(g))
    else:
        print("No potential duplicate therapies flagged.")

if args.out_json:
    with open(args.out_json, "w") as f:
        json.dump(res, f, indent=2)
    if not args.text:
        print(f"Wrote summary JSON to {args.out_json}")

Usage examples
- Stream from stdin (large export):
  cat authorized_export.json | python medsummarize_cli.py --in - --stream --text
- File input, strict duplicate policy (flag any shared-ingredient on same route):
  python medsummarize_cli.py --in authorized_export.json --text --no-er-ir-suppress

Limitations in streaming mode
- Best-effort Medication reference resolution: Medication resources encountered later are still resolved via a second pass over pending MedicationRequests kept in memory. If a MedicationReference points to a Medication not present in the same Bundle, we’ll fall back to medicationCodeableConcept/text.

3) Minimal Dockerfile and Makefile

Dockerfile
FROM python:3.11-slim
ENV PYTHONDONTWRITEBYTECODE=1 PYTHONUNBUFFERED=1
WORKDIR /app
COPY medsummarizer.py medsummarize_cli.py /app/
COPY requirements.txt /app/
RUN pip install --no-cache-dir -r requirements.txt
ENTRYPOINT ["python", "medsummarize_cli.py"]

requirements.txt
ijson
pytest

Makefile
.PHONY: test lint run
test:
	pytest -q
run:
	python medsummarize_cli.py --in authorized_export.json --text
docker-build:
	docker build -t medsummarizer:latest .
docker-run:
	cat authorized_export.json | docker run -i --rm medsummarizer:latest --in - --stream --text

