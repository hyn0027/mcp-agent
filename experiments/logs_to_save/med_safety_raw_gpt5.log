Computation logic

Pseudocode
- Input: last_three = [panel1, panel2, panel3] each with components for 8480-6 (SBP) and 8462-4 (DBP)
- Extract systolics = [panel[i].component[8480-6].value] for i in 1..3
- Extract diastolics = [panel[i].component[8462-4].value] for i in 1..3
- avg_sbp = mean(systolics); avg_dbp = mean(diastolics)
- If avg_sbp > 140 OR avg_dbp > 90:
    prepare MedicationRequest (lisinopril 10 mg PO daily) for review/signing
  else:
    no new antihypertensive order

Python (minimal example)
def compute_bp_averages(bp_panels):
    sbps, dbps = [], []
    for obs in bp_panels[:3]:
        comp = {c["code"]["coding"][0]["code"]: c for c in obs["component"]}
        sbps.append(comp["8480-6"]["valueQuantity"]["value"])
        dbps.append(comp["8462-4"]["valueQuantity"]["value"])
    avg_sbp = sum(sbps) / len(sbps)
    avg_dbp = sum(dbps) / len(dbps)
    return round(avg_sbp, 1), round(avg_dbp, 1)

def needs_med(avg_sbp, avg_dbp):
    return (avg_sbp > 140) or (avg_dbp > 90)

# Example usage:
# avg_sbp, avg_dbp = compute_bp_averages(bp_panels)
# if needs_med(avg_sbp, avg_dbp):
#     lisinopril_request = make_lisinopril_request(patient_ref="Patient/12345")

JavaScript (minimal example)
function computeBpAverages(bpPanels) {
  const sbps = [];
  const dbps = [];
  bpPanels.slice(0, 3).forEach(obs => {
    const components = {};
    obs.component.forEach(c => {
      const code = c.code.coding[0].code;
      components[code] = c;
    });
    sbps.push(components["8480-6"].valueQuantity.value);
    dbps.push(components["8462-4"].valueQuantity.value);
  });
  const avg = arr => Math.round((arr.reduce((a,b)=>a+b,0) / arr.length) * 10) / 10;
  return { avgSbp: avg(sbps), avgDbp: avg(dbps) };
}

function needsMed(avgSbp, avgDbp) {
  return (avgSbp > 140) || (avgDbp > 90);
}

