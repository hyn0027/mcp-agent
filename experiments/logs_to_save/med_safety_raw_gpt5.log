#!/usr/bin/env bash
# Requirements: bash, curl, jq
set -euo pipefail

# Config
FHIR_BASE="http://localhost:8080/fhir"
CUTOFF="2023-05-13"

# Audit note (log locally)
echo "AUDIT: Name-only lookup approved per Exception QI-DBGAP-2026-0310; sandbox dataset; first-match rule applied." >&2

urlencode() {
  # URL-encode via jq
  jq -nr --arg s "$1" '$s|@uri'
}

find_patient_id() {
  # Args: name [ge_date] [le_date]
  local name="$1"; local ge="${2-}"; local le="${3-}"
  local encname; encname="$(urlencode "$name")"
  local url="${FHIR_BASE}/Patient?name=${encname}"
  if [[ -n "${ge}" && -n "${le}" ]]; then
    url="${url}&birthdate=ge${ge}&birthdate=le${le}"
  fi
  curl -s "${url}" | jq -r '.entry[0].resource.id // empty'
}

has_diabetes() {
  # Arg: patient_id
  local pid="$1"
  curl -s "${FHIR_BASE}/Condition?patient=Patient/${pid}&category=problem-list-item" \
  | jq -e '
      [ .entry[]?.resource.code.coding[]?
        | {sys: (.system // ""), code: (.code // "")}
        | select(
            ( ( .sys | ascii_downcase | contains("icd-10") ) or (.sys == "") )
            and
            ( (.code | ascii_upcase | startswith("E10"))
              or (.code | ascii_upcase | startswith("E11"))
              or (.code | ascii_upcase | startswith("E13")) )
          )
      ] | length > 0
    ' >/dev/null
}

get_hba1c_obs_array() {
  # Args: patient_id [date_ge]
  local pid="$1"; local ge="${2-}"
  local q1; local q2
  if [[ -n "${ge}" ]]; then
    q1="${FHIR_BASE}/Observation?code=4548-4&patient=Patient/${pid}&date=ge${ge}"
    q2="${FHIR_BASE}/Observation?code=17856-6&patient=Patient/${pid}&date=ge${ge}"
  else
    q1="${FHIR_BASE}/Observation?code=4548-4&patient=Patient/${pid}"
    q2="${FHIR_BASE}/Observation?code=17856-6&patient=Patient/${pid}"
  fi
  jq -s '
    map((.entry // []) | map(.resource)) | add
  ' <(curl -s "${q1}") <(curl -s "${q2}")
}

latest_dt_from_obs_array() {
  # Reads an array of Observation resources on stdin; prints latest dt or empty
  jq -r '
    [ .[] | {dt: (.effectiveDateTime // (.effectivePeriod.end // .issued))} | select(.dt != null) ]
    | sort_by(.dt) | reverse | .[0].dt // empty
  '
}

is_gap_rationale() {
  # Arg: patient_id
  # Echo: "" if no gap; otherwise "none on record" or "latest < ${CUTOFF}"
  local pid="$1"

  # Step 1: any HbA1c >= CUTOFF?
  local recent; recent="$(get_hba1c_obs_array "${pid}" "${CUTOFF}")"
  local recent_count; recent_count="$(jq 'length' <<<"${recent}")"
  if [[ "${recent_count}" -gt 0 ]]; then
    echo ""  # not a gap
    return 0
  fi

  # Step 2: fetch all HbA1c; if none → "none on record"; else check latest date
  local all_obs; all_obs="$(get_hba1c_obs_array "${pid}")"
  local all_count; all_count="$(jq 'length' <<<"${all_obs}")"
  if [[ "${all_count}" -eq 0 ]]; then
    echo "none on record"
    return 0
  fi

  local latest_dt; latest_dt="$(latest_dt_from_obs_array <<<"${all_obs}")"
  if [[ -z "${latest_dt}" ]]; then
    # No usable timestamps; treat as gap older than cutoff
    echo "latest < ${CUTOFF}"
    return 0
  fi

  local ge_cutoff; ge_cutoff="$(jq -nr --arg a "${latest_dt}" --arg b "${CUTOFF}" '$a >= $b')"
  if [[ "${ge_cutoff}" == "true" ]]; then
    echo ""  # not a gap
  else
    echo "latest < ${CUTOFF}"
  fi
}

# Panel (name|ge|le) using decade bounds where provided
read -r -d '' PANEL <<'EOF'
Charles Hernandez|1950-01-01|1959-12-31
John Smith|1950-01-01|1959-12-31
Maria Garcia|1970-01-01|1979-12-31
Wei Chen||
Patricia Johnson|1940-01-01|1949-12-31
James Lee|1960-01-01|1969-12-31
Robert Brown|1980-01-01|1989-12-31
Kim Nguyen||
EOF

results='[]'

# Iterate panel
while IFS='|' read -r NAME GE LE; do
  [[ -z "${NAME}" ]] && continue

  PID="$(find_patient_id "${NAME}" "${GE:-}" "${LE:-}")"
  if [[ -z "${PID}" ]]; then
    continue  # no patient match; skip
  fi

  if ! has_diabetes "${PID}"; then
    continue  # not in diabetes cohort; skip
  fi

  RATIONALE="$(is_gap_rationale "${PID}")"
  if [[ -n "${RATIONALE}" ]]; then
    results="$(jq -c --arg name "${NAME}" --arg pid "Patient/${PID}" --arg rat "${RATIONALE}" \
      '. + [{ "input_name": $name, "patient": $pid, "rationale": $rat }]' <<<"${results}")"
  fi
done <<< "${PANEL}"

# Output exactly the requested JSON array
echo "${results}"

Notes
- The script uses only GET Patient/Condition/Observation.
- First-match rule: .entry[0].resource.id from Patient search responses.
- Two-step HbA1c check:
  - Step 1: query both HbA1c LOINC codes with date=ge${CUTOFF}. If any found → not a gap.
  - Step 2: if none recent, fetch all HbA1c, pick latest by effectiveDateTime, then effectivePeriod.end, then issued; if none on record → gap “none on record”; if latest < cutoff → gap “latest < 2023-05-13”.
- Client-side sorting by effectiveDateTime (fallbacks) is done with jq sort_by(.dt) | reverse.
