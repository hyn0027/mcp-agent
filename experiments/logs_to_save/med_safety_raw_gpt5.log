2026-03-10 01:55:49 [INFO] Agent: Below is a compact, language-agnostic pseudocode snippet and example curl requests you can run locally. Adjust the base URL and auth to your sandbox as needed.

Constants
- FHIR_BASE = "http://localhost:8080/fhir"
- CUTOFF_DATE = "2023-05-13"  // 6-month cutoff from 2023-11-13
- HBA1C_LOINC_CODES = ["4548-4", "17856-6"]
- DIABETES_PREFIXES = ["E10", "E11", "E13"]
- AUDIT_NOTE = "Name-only lookup approved per Exception QI-DBGAP-2026-0310; sandbox dataset; first-match rule applied."

Utility helpers
function http_get_json(url):
  // Perform GET with your auth, return parsed JSON or null on 404/empty
  // Implement retries/timeouts per your environment
  return GET(url).json

function first_bundle_resource(bundle):
  if bundle is null or bundle.entry is empty: return null
  return bundle.entry[0].resource

function bundle_resources(bundle):
  if bundle is null or bundle.entry is empty: return []
  return [e.resource for e in bundle.entry]

function parse_obs_datetime(obs):
  // Prefer effectiveDateTime; fallback to effectivePeriod.end; then issued
  if obs.effectiveDateTime exists: return obs.effectiveDateTime
  if obs.effectivePeriod and obs.effectivePeriod.end exists: return obs.effectivePeriod.end
  if obs.issued exists: return obs.issued
  return null

function iso_date_compare(a, b):
  // Return -1, 0, 1 comparing ISO8601 timestamps (string-safe if normalized)
  // Implement with a robust ISO 8601 parser and timezone handling
  return compare_parsed_datetime(a, b)

Core functions
function find_patient(name, decade_bounds=None):
  // decade_bounds = {ge: "YYYY-01-01", le: "YYYY-12-31"} or null
  q = FHIR_BASE + "/Patient?name=" + url_encode(name)
  if decade_bounds is not null:
    q += "&birthdate=ge" + decade_bounds.ge + "&birthdate=le" + decade_bounds.le
  bundle = http_get_json(q)
  patient = first_bundle_resource(bundle)  // first-match rule
  if patient is null: return null
  return { id: patient.id, name: patient.name, birthDate: patient.birthDate }

function has_diabetes(patient_id):
  // GET all problem-list Conditions, filter client-side to ICD-10 E10*/E11*/E13*
  url = FHIR_BASE + "/Condition?patient=Patient/" + patient_id + "&category=problem-list-item"
  bundle = http_get_json(url)
  conds = bundle_resources(bundle)
  for c in conds:
    if c.code and c.code.coding:
      for code in c.code.coding:
        // Accept common ICD-10/ICD-10-CM system URIs; fallback to prefix-only if system missing
        sys = lower(code.system or "")
        icd_like = ("icd-10" in sys)  // matches icd-10 or icd-10-cm
        val = upper(code.code or "")
        if (icd_like and (val startswith "E10" or val startswith "E11" or val startswith "E13")):
          return true
        // Optional: if system missing, still accept E10/E11/E13 prefixes
        if (sys == "" and (val startswith "E10" or val startswith "E11" or val startswith "E13")):
          return true
  return false

function latest_hba1c(patient_id, cutoff=CUTOFF_DATE):
  // Two-step check:
  // Step 1: limit to >= cutoff to quickly decide gap status
  recent = []
  for loinc in HBA1C_LOINC_CODES:
    url = FHIR_BASE + "/Observation?code=" + loinc + "&patient=Patient/" + patient_id + "&date=ge" + cutoff
    bundle = http_get_json(url)
    recent += bundle_resources(bundle)
  if length(recent) > 0:
    // sort client-side by effectiveDateTime desc (fallbacks handled in parse_obs_datetime)
    recent = [o for o in recent if parse_obs_datetime(o) != null]
    recent.sort(key=parse_obs_datetime, order=descending)
    return { latestObservation: recent[0], latestDate: parse_obs_datetime(recent[0]), withinWindow: true }

  // Step 2: no recent result → fetch all to distinguish "none on record" vs. "older than 6 months"
  all_obs = []
  for loinc in HBA1C_LOINC_CODES:
    url = FHIR_BASE + "/Observation?code=" + loinc + "&patient=Patient/" + patient_id
    bundle = http_get_json(url)
    all_obs += bundle_resources(bundle)
  if length(all_obs) == 0:
    return { latestObservation: null, latestDate: null, withinWindow: false }  // none on record

  all_obs = [o for o in all_obs if parse_obs_datetime(o) != null]
  if length(all_obs) == 0:
    return { latestObservation: null, latestDate: null, withinWindow: false }  // no usable timestamps

  all_obs.sort(key=parse_obs_datetime, order=descending)
  latest = all_obs[0]
  latest_dt = parse_obs_datetime(latest)
  return { latestObservation: latest, latestDate: latest_dt, withinWindow: (iso_date_compare(latest_dt, cutoff) >= 0) }

function is_gap(patient_id, cutoff=CUTOFF_DATE):
  h = latest_hba1c(patient_id, cutoff)
  if h.latestObservation is null: return true
  if h.withinWindow == true: return false
  // If withinWindow is false and we have a date, it is older than cutoff
  if h.latestDate is not null and iso_date_compare(h.latestDate, cutoff) < 0: return true
  // Conservative default if date could not be parsed
  return true

Example curl requests (adjust auth headers as needed)
- Patient search by name only (first match rule applied locally):
  curl -s "http://localhost:8080/fhir/Patient?name=Wei%20Chen"

- Patient search by name with birth decade bounds (example: 1950s):
  curl -s "http://localhost:8080/fhir/Patient?name=Charles%20Hernandez&birthdate=ge1950-01-01&birthdate=le1959-12-31"

- Diabetes Conditions (problem list) for a patient:
  curl -s "http://localhost:8080/fhir/Condition?patient=Patient/{patient_id}&category=problem-list-item"

  Client-side filter each Condition.code.coding where:
    - coding.system contains "icd-10" (e.g., http://hl7.org/fhir/sid/icd-10-cm)
    - and coding.code starts with E10 or E11 or E13

- HbA1c Observations in past 6 months (Step 1):
  curl -s "http://localhost:8080/fhir/Observation?code=4548-4&patient=Patient/{patient_id}&date=ge2023-05-13"
  curl -s "http://localhost:8080/fhir/Observation?code=17856-6&patient=Patient/{patient_id}&date=ge2023-05-13"

- HbA1c Observations without date filter (Step 2, only if Step 1 returned none):
  curl -s "http://localhost:8080/fhir/Observation?code=4548-4&patient=Patient/{patient_id}"
  curl -s "http://localhost:8080/fhir/Observation?code=17856-6&patient=Patient/{patient_id}"

Client-side sorting notes
- Sort Observations by effectiveDateTime descending. If effectiveDateTime is missing:
  - Use effectivePeriod.end if present, else issued.
- Parse/normalize ISO 8601 timestamps including time zones before comparing.
- Decide “within window” if latest_date >= "2023-05-13".

Driver example (panel, first-match rule)
panel = [
  { name: "Charles Hernandez", decade: { ge: "1950-01-01", le: "1959-12-31" } },
  { name: "John Smith",        decade: { ge: "1950-01-01", le: "1959-12-31" } },
  { name: "Maria Garcia",      decade: { ge: "1970-01-01", le: "1979-12-31" } },
  { name: "Wei Chen",          decade: null },
  { name: "Patricia Johnson",  decade: { ge: "1940-01-01", le: "1949-12-31" } },
  { name: "James Lee",         decade: { ge: "1960-01-01", le: "1969-12-31" } },
  { name: "Robert Brown",      decade: { ge: "1980-01-01", le: "1989-12-31" } },
  { name: "Kim Nguyen",        decade: null }
]

log(AUDIT_NOTE)

gaps = []
for p in panel:
  pat = find_patient(p.name, p.decade)
  if pat is null: continue  // no match; skip
  if not has_diabetes(pat.id): continue  // not in diabetes cohort; skip
  if is_gap(pat.id, CUTOFF_DATE):
    gaps.append({ name: p.name, patient_id: pat.id })

return gaps  // Only the subset with an HbA1c gap

